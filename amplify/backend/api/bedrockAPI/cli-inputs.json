{
  "version": 1,
  "paths": {
    "/chat": {
      "name": "/chat",
      "lambdaFunction": "bedrockChatFunction",
      "permissions": {
        "setting": "open"
      },
      "cors": {
        "origin": "*",
        "headers": ["Content-Type", "X-Amz-Date", "Authorization", "X-Api-Key", "X-Amz-Security-Token"],
        "allowCredentials": false
      }
    }
  }
}